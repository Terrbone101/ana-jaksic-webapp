# Copy this file to .env and fill in your own keys.
# These are all PUBLIC/publishable keys - never put secret keys in this frontend app.

# Stripe: create a free account at https://dashboard.stripe.com
# Publishable key (starts with pk_test_ or pk_live_) - safe to expose in the browser
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Payment Links - create one per course in the Stripe Dashboard
# (Dashboard -> Payment Links -> New). Paste the resulting URLs below, matched by course id.
# See src/data/courses.ts for the course ids.
VITE_STRIPE_LINK_TEST_COURSE=
VITE_STRIPE_LINK_COLOR_THEORY=
VITE_STRIPE_LINK_SHAPE_LIGHT=
VITE_STRIPE_LINK_BRIDAL=
VITE_STRIPE_LINK_EDITORIAL=
VITE_STRIPE_LINK_ONLINE=
VITE_STRIPE_LINK_MENTORING=

# Same idea for shop products - see src/data/products.ts
VITE_STRIPE_LINK_PRODUCT_PALETTE=
VITE_STRIPE_LINK_PRODUCT_BRUSHES=
VITE_STRIPE_LINK_PRODUCT_WORKBOOK=

# PayPal: create an app at https://developer.paypal.com/dashboard/applications
# Client ID (safe to expose in the browser). Leave empty to use PayPal's public sandbox demo id.
VITE_PAYPAL_CLIENT_ID=

# Zoom meeting link for the live "Online Masterclass" course - shown as a
# "Join on Zoom" button after a successful booking. Leave empty to hide the
# button. Update this per session (e.g. a recurring personal meeting room
# link, or the link for the next scheduled date).
VITE_ZOOM_LINK_ONLINE=
